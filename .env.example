# ============================================================================
# HAYAT REHBERİ - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# Gerçek anahtarlarınızı .env dosyasına yazınız (.env dosyası GitHub'a yüklenmez)
# ============================================================================

# Gemini AI API Anahtarı (Sunucu tarafında kelime/tefsir analizi için kullanılır)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Uygulamanın barındırıldığı ana URL (CORS ve Origin güvenliği için)
APP_URL="http://localhost:3000"

# İsteğe Bağlı: Geliştirici İletişim E-Postası (Tanımlanmazsa güvenli varsayılan kullanılır)
DEVELOPER_EMAIL=""

# İsteğe Bağlı: Özel Yönetici Şifresi (Tanımlanmazsa SHA-256 özet doğrulaması kullanılır)
ADMIN_PASSKEY=""

# Gemini API Kota Koruması Limitleri (Varsayılan değerler)
GEMINI_RATE_LIMIT_PER_MIN="10"
GEMINI_RATE_LIMIT_PER_HOUR="60"
GEMINI_DAILY_MAX_REQUESTS="500"

# Google Maps Platform API Anahtarı (Yakındaki Camiler harita ve konum servisi için)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

