rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private progress: users/{uid}/progress/{allowed application key}.
    // Required: schemaVersion int 1, value JSON string <=180000 characters,
    // deleted bool (tombstone requires empty value), updatedAt server time.
    // Large roots: schemaVersion 2, empty value, deleted false, chunkCount 1..6.
    // Chunks: {key}__part_{index}, schemaVersion 2, chunkOf allowed key <=100
    // characters, index int 0..5, nonempty value <=180000, updatedAt server time.
    // New clients add operationId (safe string 1..80) to root, chunks and
    // receipt. It proves a write even if concurrent commits share a timestamp.
    // Legacy envelopes remain accepted for a compatible rolling deployment.
    // Retry watermarks: users/{uid}/devices/{deviceId}_{progressKey}.
    // Required: schemaVersion int 2, deviceId 1..80 safe characters, allowed
    // key <=100 characters, sequence 1..MAX_SAFE_INTEGER, updatedAt server time.
    // Device and key are immutable. Each watermark update requires a progress
    // write in the same atomic operation. No roles, profiles or public records.
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function allowedKey(key) {
      return key in [
        'namaz_memorized_ids','esma_learned_names','elifba_state',
        'tecvid_completed_lessons','ezber_saved_surahs',
        'hayat_rehberi_hadis_user_state_v1','hayat_rehberi_hadis_custom_order_v1',
        'hayat_rehberi_hadis_activity_logs_v1','quran_listening_manual_bookmarks_v1',
        'kuran_user_bookmarks_v1','kuran_mushaf_read_pages_v1',
        'kaza_namazlari_data','kaza_custom_counters_data','hayat_rehberi_special_goals_v1',
        'appData','quran_listening_completed_cycles_v1'
      ] || key.matches('^kaza_today_20[0-9]{2}-[0-9]{2}-[0-9]{2}$');
    }
    function validOperation(data) {
      return !data.keys().hasAny(['operationId']) ||
        (data.operationId is string && data.operationId.matches('^[a-zA-Z0-9_-]{1,80}$'));
    }
    function chunkHeader(data,key,index,operation) {
      return data.schemaVersion == 2 && data.chunkOf == key && data.index == index
        && data.get('operationId','') == operation && data.updatedAt == request.time;
    }
    function hasChunk(key,index,count,operation) {
      return count <= index || chunkHeader(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key + '__part_' + string(index))).data,key,index,operation);
    }
    function isValidProgress(data,key) {
      let common = data.keys().hasAll(['schemaVersion','value','deleted','updatedAt'])
        && data.schemaVersion is int && data.value is string && data.value.size() <= 180000
        && data.deleted is bool && (!data.deleted || data.value == '')
        && data.updatedAt is timestamp && data.updatedAt == request.time && validOperation(data);
      return common && ((data.schemaVersion == 1
        && data.keys().hasOnly(['schemaVersion','value','deleted','updatedAt','operationId'])
      ) || (data.schemaVersion == 2 && data.keys().hasAll(['chunkCount'])
        && data.keys().hasOnly(['schemaVersion','value','deleted','updatedAt','chunkCount','operationId'])
        && data.deleted == false && data.value == ''
        && data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 6
        && hasChunk(key,0,data.chunkCount,data.get('operationId','')) && hasChunk(key,1,data.chunkCount,data.get('operationId',''))
        && hasChunk(key,2,data.chunkCount,data.get('operationId','')) && hasChunk(key,3,data.chunkCount,data.get('operationId',''))
        && hasChunk(key,4,data.chunkCount,data.get('operationId','')) && hasChunk(key,5,data.chunkCount,data.get('operationId',''))));
    }
    function isValidChunk(data,id) {
      return data.keys().hasAll(['schemaVersion','chunkOf','index','value','updatedAt'])
        && data.keys().hasOnly(['schemaVersion','chunkOf','index','value','updatedAt','operationId'])
        && data.schemaVersion is int && data.schemaVersion == 2
        && data.chunkOf is string && data.chunkOf.size() <= 100 && allowedKey(data.chunkOf)
        && data.index is int && data.index >= 0 && data.index < 6
        && id == data.chunkOf + '__part_' + string(data.index)
        && data.value is string && data.value.size() > 0 && data.value.size() <= 180000
        && data.updatedAt is timestamp && validOperation(data);
    }
    function chunkHasManifest(uid,data) {
      let manifest = getAfter(/databases/$(database)/documents/users/$(uid)/progress/$(data.chunkOf));
      return manifest.data.schemaVersion == 2 && manifest.data.chunkCount > data.index
        && manifest.data.get('operationId','') == data.get('operationId','')
        && hasProgressWrite(uid,data.chunkOf,data.get('operationId',''));
    }
    function canRemoveChunk(uid,data) {
      let manifest = getAfter(/databases/$(database)/documents/users/$(uid)/progress/$(data.chunkOf));
      return hasProgressWrite(uid,data.chunkOf,manifest.data.get('operationId','')) &&
        (manifest.data.schemaVersion == 1 || manifest.data.chunkCount <= data.index);
    }
    function isValidDevice(data,receiptId) {
      return data.keys().hasAll(['schemaVersion','deviceId','key','sequence','updatedAt'])
        && data.keys().hasOnly(['schemaVersion','deviceId','key','sequence','updatedAt','operationId'])
        && data.schemaVersion is int && data.schemaVersion == 2
        && data.deviceId is string && data.deviceId.matches('^[a-zA-Z0-9_-]{1,80}$')
        && data.key is string && data.key.size() <= 100 && allowedKey(data.key)
        && receiptId == data.deviceId + '_' + data.key
        && data.sequence is int && data.sequence > 0 && data.sequence <= 9007199254740991
        && data.updatedAt is timestamp && data.updatedAt == request.time && validOperation(data);
    }
    function hasProgressWrite(uid,key,operation) {
      let progress = /databases/$(database)/documents/users/$(uid)/progress/$(key);
      return getAfter(progress).data.updatedAt == request.time
        && getAfter(progress).data.get('operationId','') == operation
        && (!exists(progress) || (operation != ''
          ? get(progress).data.get('operationId','') != operation
          : get(progress).data.updatedAt != getAfter(progress).data.updatedAt));
    }
    match /users/{uid}/progress/{key} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        ((allowedKey(key) && isValidProgress(request.resource.data,key)) ||
        (isValidChunk(request.resource.data,key) && request.resource.data.updatedAt == request.time && chunkHasManifest(uid,request.resource.data)));
      allow delete: if isOwner(uid) && !allowedKey(key) && isValidChunk(resource.data,key)
        && canRemoveChunk(uid,resource.data);
    }
    match /users/{uid}/devices/{receiptId} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && isValidDevice(request.resource.data,receiptId)
        && hasProgressWrite(uid,request.resource.data.key,request.resource.data.get('operationId',''));
      allow update: if isOwner(uid) && isValidDevice(request.resource.data,receiptId)
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.key == resource.data.key
        && request.resource.data.sequence > resource.data.sequence
        && hasProgressWrite(uid,request.resource.data.key,request.resource.data.get('operationId',''));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
